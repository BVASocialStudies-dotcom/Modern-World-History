<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Modern World History — Course Hub</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=Source+Sans+3:wght@400;500;600;700&family=Cormorant+Garamond:ital@1&display=swap');

  :root{
    --ink:#1a0f2e;
    --ink-2:#2b1b47;
    --ink-3:#231539;
    --parchment:#f0e6fb;
    --parchment-dim:#b8a4d9;
    --gold:#a86ee8;
    --gold-bright:#d9a6ff;
    --crimson:#c23b6b;
    --sage:#6b8f71;
    --sage-bright:#8fc79a;
    --rule:rgba(168,110,232,0.35);
  }

  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    min-height:100vh;
    background:
      radial-gradient(ellipse at 15% -10%, rgba(217,166,255,0.10), transparent 55%),
      radial-gradient(ellipse at 100% 110%, rgba(194,59,107,0.10), transparent 50%),
      var(--ink);
    color:var(--parchment);
    font-family:'Source Sans 3', sans-serif;
    display:flex;
    justify-content:center;
    padding:36px 16px 70px;
  }

  .stage{width:100%;max-width:1140px;}

  /* ---------- Masthead ---------- */
  .masthead{
    text-align:center;
    padding-bottom:24px;
    margin-bottom:34px;
    border-bottom:2px solid var(--rule);
    position:relative;
  }
  .eyebrow{
    font-family:'Cormorant Garamond', serif;
    font-style:italic;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--gold-bright);
    font-size:14px;
    margin-bottom:8px;
  }
  .masthead h1{
    font-family:'Playfair Display', serif;
    font-weight:800;
    font-size:clamp(32px,5.5vw,52px);
    margin:0 0 10px;
    letter-spacing:0.01em;
  }
  .masthead p{
    color:var(--parchment-dim);
    font-size:15.5px;
    max-width:620px;
    margin:0 auto;
    line-height:1.55;
  }
  .compass{
    width:46px;height:46px;margin:0 auto 14px;
    border-radius:50%;
    background:radial-gradient(circle at 35% 30%, var(--gold-bright), var(--gold) 55%, #4d2b7a 100%);
    display:flex;align-items:center;justify-content:center;
    font-family:'Playfair Display',serif;font-weight:800;font-size:20px;color:var(--ink);
    box-shadow:0 4px 14px rgba(0,0,0,0.35);
  }

  /* ---------- Legend ---------- */
  .legend{
    display:flex;justify-content:center;gap:22px;flex-wrap:wrap;
    margin-bottom:32px;font-size:12.5px;color:var(--parchment-dim);
    letter-spacing:0.03em;
  }
  .legend span{display:inline-flex;align-items:center;gap:6px;}
  .dot{width:9px;height:9px;border-radius:50%;display:inline-block;}
  .dot.live{background:var(--sage-bright);}
  .dot.soon{background:var(--parchment-dim);opacity:0.6;}

  /* ---------- Unit grid ---------- */
  .grid{
    display:grid;
    grid-template-columns:1fr;
    gap:22px;
  }
  @media(min-width:760px){
    .grid{grid-template-columns:1fr 1fr;}
  }

  .unit-card{
    background:linear-gradient(180deg, var(--ink-2), rgba(43,27,71,0.35));
    border:1px solid var(--rule);
    border-radius:8px;
    padding:22px 22px 20px;
    position:relative;
    overflow:hidden;
  }
  .unit-card::before{
    content:"";
    position:absolute; inset:0;
    background:repeating-linear-gradient(115deg, rgba(255,255,255,0.012) 0 2px, transparent 2px 6px);
    pointer-events:none;
  }

  .unit-head{
    display:flex;
    align-items:flex-start;
    gap:14px;
    margin-bottom:16px;
    padding-bottom:14px;
    border-bottom:1px solid var(--rule);
  }
  .unit-num{
    flex:0 0 auto;
    width:46px;height:46px;border-radius:50%;
    background:radial-gradient(circle at 35% 30%, var(--gold-bright), var(--gold) 55%, #4d2b7a 100%);
    display:flex;align-items:center;justify-content:center;
    font-family:'Playfair Display',serif;font-weight:800;font-size:18px;color:var(--ink);
    box-shadow:0 3px 10px rgba(0,0,0,0.3);
  }
  .unit-titles .kicker{
    font-family:'Cormorant Garamond',serif;font-style:italic;
    color:var(--gold-bright);font-size:13px;margin-bottom:2px;
  }
  .unit-titles h2{
    font-family:'Playfair Display',serif;
    font-size:19px;
    margin:0;
    line-height:1.25;
  }

  .activities{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px;}

  .activity{
    display:flex;
    align-items:center;
    gap:11px;
    padding:11px 13px;
    border-radius:5px;
    border:1px solid rgba(201,162,39,0.0);
    text-decoration:none;
    color:var(--parchment);
    font-size:13.5px;
    transition:border-color .15s, background .15s, transform .1s;
  }
  .activity.live{
    background:rgba(255,255,255,0.03);
    border-color:rgba(168,110,232,0.22);
    cursor:pointer;
  }
  .activity.live:hover{
    border-color:var(--gold-bright);
    background:rgba(217,166,255,0.08);
    transform:translateX(2px);
  }
  .activity.soon{
    background:rgba(255,255,255,0.015);
    border:1px dashed rgba(184,164,217,0.28);
    color:var(--parchment-dim);
  }
  .a-icon{
    flex:0 0 auto;
    width:26px;height:26px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    font-size:12px;
  }
  .activity.live .a-icon{background:rgba(143,199,154,0.18);color:var(--sage-bright);}
  .activity.soon .a-icon{background:rgba(184,164,217,0.12);color:var(--parchment-dim);}
  .a-body{flex:1;min-width:0;}
  .a-title{font-weight:600;display:block;}
  .a-sub{display:block;font-size:11.5px;color:var(--parchment-dim);margin-top:1px;}
  .activity.live .a-sub{color:var(--sage-bright);}
  .a-arrow{flex:0 0 auto;font-size:15px;color:var(--gold-bright);opacity:0;transition:opacity .15s;}
  .activity.live:hover .a-arrow{opacity:1;}

  footer.note{
    text-align:center;color:var(--parchment-dim);font-size:12px;margin-top:36px;
    font-family:'Cormorant Garamond',serif;font-style:italic;
    line-height:1.6;
  }
</style>
</head>
<body>
<div class="stage">
  <div class="masthead">
    <div class="compass">✦</div>
    <div class="eyebrow">10th Grade · Modern World History</div>
    <h1>Course Hub</h1>
    <p>Eight units, three activities each. Click any lit-up activity to launch it — new activities will light up here as they're added throughout the year.</p>
  </div>

  <div class="legend">
    <span><i class="dot live"></i> Ready to launch</span>
    <span><i class="dot soon"></i> Coming soon</span>
  </div>

  <div class="grid" id="grid"></div>

  <footer class="note">Keep every activity file in the same folder as this page so the links above work when opened in your browser.</footer>
</div>

<script>
const UNITS = [
  {
    num:1,
    kicker:"c. 1350–1600",
    title:"Renaissance & Reformation",
    activities:[
      {title:"Renaissance Ideas & Art", sub:"Coming soon"},
      {title:"The Protestant Reformation", sub:"Coming soon"},
      {title:"Christian Humanism", sub:"Coming soon"}
    ]
  },
  {
    num:2,
    kicker:"c. 1400–1700",
    title:"Age of Exploration & Global Encounters",
    activities:[
      {title:"European Exploration", sub:"Coming soon"},
      {title:"The Columbian Exchange", sub:"Coming soon"},
      {title:"Early Global Trade Networks", sub:"Coming soon"}
    ]
  },
  {
    num:3,
    kicker:"c. 1600–1750",
    title:"Absolutism & Constitutionalism",
    activities:[
      {title:"Absolute Monarchs of Europe", sub:"Coming soon"},
      {title:"The English Civil War", sub:"Coming soon"},
      {title:"Constitutional Government", sub:"Coming soon"}
    ]
  },
  {
    num:4,
    kicker:"c. 1650–1789",
    title:"The Scientific Revolution & the Enlightenment",
    activities:[
      {title:"The Salon: Enlightenment Thinkers", sub:"Ready to launch", href:"enlightenment_game.html"},
      {title:"The Scientific Revolution", sub:"Coming soon"},
      {title:"Enlightenment & Society", sub:"Coming soon"}
    ]
  },
  {
    num:5,
    kicker:"c. 1775–1825",
    title:"Revolutions in the Atlantic World",
    activities:[
      {title:"The American Revolution", sub:"Coming soon"},
      {title:"The French Revolution", sub:"Coming soon"},
      {title:"Latin American Independence", sub:"Coming soon"}
    ]
  },
  {
    num:6,
    kicker:"c. 1750–1900",
    title:"Industrial Revolution & Reform",
    activities:[
      {title:"Causes of Industrialization", sub:"Coming soon"},
      {title:"Life in Industrial Cities", sub:"Coming soon"},
      {title:"Reform Movements & New Ideologies", sub:"Coming soon"}
    ]
  },
  {
    num:7,
    kicker:"c. 1800–1914",
    title:"Imperialism & Nationalism",
    activities:[
      {title:"The Scramble for Africa", sub:"Coming soon"},
      {title:"Imperialism in Asia", sub:"Coming soon"},
      {title:"Rising Nationalism in Europe", sub:"Coming soon"}
    ]
  },
  {
    num:8,
    kicker:"c. 1914–1939",
    title:"World War I & the Interwar Years",
    activities:[
      {title:"Causes & Course of World War I", sub:"Coming soon"},
      {title:"The Russian Revolution", sub:"Coming soon"},
      {title:"The Rise of Totalitarianism", sub:"Coming soon"}
    ]
  }
];

function renderUnits(){
  const grid = document.getElementById('grid');
  grid.innerHTML = UNITS.map(u=>{
    const acts = u.activities.map(a=>{
      const isLive = !!a.href;
      if(isLive){
        return `<a class="activity live" href="${a.href}">
          <span class="a-icon">▸</span>
          <span class="a-body">
            <span class="a-title">${a.title}</span>
            <span class="a-sub">${a.sub}</span>
          </span>
          <span class="a-arrow">→</span>
        </a>`;
      }
      return `<div class="activity soon">
        <span class="a-icon">○</span>
        <span class="a-body">
          <span class="a-title">${a.title}</span>
          <span class="a-sub">${a.sub}</span>
        </span>
      </div>`;
    }).join('');

    return `<div class="unit-card">
      <div class="unit-head">
        <div class="unit-num">${u.num}</div>
        <div class="unit-titles">
          <div class="kicker">Unit ${u.num} · ${u.kicker}</div>
          <h2>${u.title}</h2>
        </div>
      </div>
      <div class="activities">${acts}</div>
    </div>`;
  }).join('');
}

renderUnits();
</script>
</body>
</html>
